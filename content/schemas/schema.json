{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KDSP content schemas",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "level": {
      "type": "string",
      "enum": [
        "N5",
        "N4",
        "N3",
        "N2",
        "N1",
        "OTHER"
      ]
    },
    "file_ref": {
      "type": "object",
      "required": [
        "id",
        "path",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9_./-]+\\.json$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "course": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "slug",
        "title",
        "level",
        "module_refs"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "language": {
          "const": "ja"
        },
        "target_language": {
          "const": "vi"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "module_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_ref"
          }
        },
        "cover_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "course_id",
        "title",
        "order",
        "lesson_refs"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "course_id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "lesson_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_ref"
          }
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "order",
        "data"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "instructions": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "item_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "enum": [
                  "vocabulary",
                  "grammar",
                  "exercise"
                ]
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "lesson": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "course_id",
        "module_id",
        "title",
        "order",
        "activities"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "course_id": {
          "$ref": "#/$defs/id"
        },
        "module_id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "vocabulary_item": {
      "type": "object",
      "required": [
        "id",
        "level",
        "jp",
        "vi"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "topic": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "jp": {
          "type": "string",
          "minLength": 1
        },
        "kanji": {
          "type": "string"
        },
        "romaji": {
          "type": "string"
        },
        "vi": {
          "type": "string",
          "minLength": 1
        },
        "mnemonic": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "grammar_item": {
      "type": "object",
      "required": [
        "id",
        "level",
        "pattern"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "topic": {
          "type": "string"
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string"
        },
        "structure": {
          "type": "string"
        },
        "usage": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "examples": {
          "type": "array"
        },
        "commonMistakes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "exercise_item": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "level",
        "prompt_jp",
        "answer"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "exercise"
        },
        "kind": {
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "topic": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompt_jp": {
          "type": "string",
          "minLength": 1
        },
        "prompt_vi": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
